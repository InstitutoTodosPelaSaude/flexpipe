from types import SimpleNamespace
from pathlib import Path

# Path to the build config.yaml, passed to flexpipe-* CLI subprocesses (e.g. flexpipe-curate).
# flexpipe-run injects the absolute path via --config build_config=<path>.
# Direct snakemake invocations must supply --configfile <build>/config.yaml explicitly.
_config = config.get("build_config")
if not _config:
    if workflow.configfiles:
        _config = str(workflow.configfiles[0])
    else:
        raise ValueError(
            "No build config found. Supply --configfile <build>/config.yaml or use "
            "flexpipe-run --config <build>/config.yaml --workdir <path>."
        )

_repo_root = Path(workflow.basedir).resolve().parent
_build_dir = Path(_config).resolve().parent if _config else _repo_root


def _resolve_path(value):
    if value is None or str(value).strip() == "":
        return value
    p = Path(str(value)).expanduser()
    if p.is_absolute():
        return str(p)
    build_candidate = (_build_dir / p).resolve()
    repo_candidate = (_repo_root / p).resolve()
    if build_candidate.exists():
        return str(build_candidate)
    if repo_candidate.exists():
        return str(repo_candidate)
    return str(build_candidate)


def _resolve_section_paths(section, keys):
    section = dict(section or {})
    for key in keys:
        if key in section:
            section[key] = _resolve_path(section[key])
    return section


def _viralqc_command(viralqc_cfg):
    runner = viralqc_cfg.get("runner", "conda")
    executable = viralqc_cfg.get("executable", "vqc")
    if runner == "direct":
        return [executable]
    return [runner, "run", "-n", viralqc_cfg.get("conda_env", "viralQC"), executable]


# Per-run output directory. Passed by flexpipe-run as --config workdir=<path>.
# Defaults to "." so a direct snakemake invocation still works from the repo root.
_wd = config.get("workdir", ".")

# Reference date for this run (YYYY-MM-DD). Injected by flexpipe-run via --config run_date=.
# When present it is written into the workdir-local subsample config as defaults.max_date
# so that augur subsample is bounded by the declared analysis window rather than the
# system clock.  Empty string means no bound (backwards-compatible for direct snakemake
# invocations).
_run_date = config.get("run_date", "")
_run_date_arg = ["--run-date", _run_date] if _run_date else []

_local   = _resolve_section_paths(config.get("local_sequences", {}), ["metadata", "sequences"])
_local_src = _resolve_section_paths(config.get("local", {}), ["metadata", "sequences"])
_vqc     = config.get("viralqc", {})
_viralqc_mode        = _vqc.get("mode", "run")
_viralqc_precomputed = _vqc.get("precomputed", "")
_sub     = config.get("subsampling", {})
_coords  = _resolve_section_paths(config.get("coordinates", {}), ["force_file"])
_curation = _resolve_section_paths(config.get("curation", {}), ["date_formats"])
_colours = config.get("colours", {})
_qc      = config.get("qc", {})
_coordinate_columns = _coords.get("columns", "country division location").split()

# Derive augur-filter exclusion clauses from qc.genome_quality (pass-list → fail-list)
_pass_grades = set(_qc.get("genome_quality", ["A", "B"]))
_all_grades  = {"A", "B", "C", "D"}
_fail_grades = sorted(_all_grades - _pass_grades)
_quality_filter = [f"genome_quality={g}" for g in _fail_grades] + ["genome_quality="]

_req_cols        = _qc.get("required_columns", ["strain", "date"])
_req_col_filter  = [f"{col}=" for col in _req_cols]

# Optional force-coordinates file
_force_file_arg  = ["--force-file", _coords["force_file"]] if _coords.get("force_file") else []
_date_policy_arg = ["--policy", _curation["date_formats"]] if _curation.get("date_formats") else []

# "pathoplexus" (default) or "ncbi" — never both simultaneously
_source = config.get("data_source", "pathoplexus")

# Source-specific raw-fetch outputs
_RAW_METADATA  = f"{_wd}/results/ingest/{_source}_metadata.tsv"
_RAW_SEQUENCES = f"{_wd}/results/ingest/{_source}_sequences.fasta"

# Workdir coordinate cache (writable; seeded from build dir on first run by flexpipe-run)
_workdir_cache = f"{_wd}/cache/cache_coordinates.tsv"
_name2hue_cache = f"{_wd}/cache/name2hue.tsv"
_SUBSAMPLED_SEQUENCES = f"{_wd}/results/subsampled/sequences.fasta"
_SUBSAMPLED_METADATA = f"{_wd}/results/subsampled/metadata.tsv"
_SUBSAMPLED_METADATA_RAW = f"{_wd}/results/subsampled/metadata.raw.tsv"

files = SimpleNamespace(
    **_resolve_section_paths(
        config["files"],
        ["keep", "ignore", "cache", "reference", "clades", "auspice_config", "subsample_config"],
    )
)


rule all:
    input:
        sequences     = _SUBSAMPLED_SEQUENCES,
        metadata      = _SUBSAMPLED_METADATA,
        latlongs      = f"{_wd}/config/latlongs.tsv",
        colour_scheme = f"{_wd}/config/colour_scheme.tsv",
        qc_report     = f"{_wd}/results/qc_report.json",
        qc_summary    = f"{_wd}/results/qc_summary.tsv"


# ─── Fetch + merge ────────────────────────────────────────────────────────────

rule fetch_pathoplexus:
    output:
        metadata  = f"{_wd}/results/ingest/pathoplexus_metadata.tsv",
        sequences = f"{_wd}/results/ingest/pathoplexus_sequences.fasta"
    params:
        cfg = _config,
        run_date_arg = _run_date_arg
    shell:
        """
        flexpipe-fetch-pathoplexus \
            --config           {params.cfg:q} \
            --metadata-output  {output.metadata:q} \
            --sequences-output {output.sequences:q} \
            {params.run_date_arg:q}
        """


rule fetch_ncbi:
    output:
        metadata  = f"{_wd}/results/ingest/ncbi_metadata.tsv",
        sequences = f"{_wd}/results/ingest/ncbi_sequences.fasta"
    params:
        cfg = _config,
        run_date_arg = _run_date_arg
    shell:
        """
        flexpipe-fetch-ncbi \
            --config           {params.cfg:q} \
            --metadata-output  {output.metadata:q} \
            --sequences-output {output.sequences:q} \
            {params.run_date_arg:q}
        """


# data_source=local: copy user-supplied files verbatim — no network fetch needed.
if _source == "local":
    rule fetch_local:
        input:
            metadata  = _local_src.get("metadata",  ""),
            sequences = _local_src.get("sequences", ""),
        output:
            metadata  = f"{_wd}/results/ingest/local_metadata.tsv",
            sequences = f"{_wd}/results/ingest/local_sequences.fasta",
        shell:
            """
            cp {input.metadata:q}  {output.metadata:q}
            cp {input.sequences:q} {output.sequences:q}
            """


rule merge_local_sequences:
    input:
        ppx_metadata  = _RAW_METADATA,
        ppx_sequences = _RAW_SEQUENCES
    params:
        source          = _source,
        local_metadata  = _local.get("metadata",  ""),
        local_sequences = _local.get("sequences", ""),
        enabled         = _local.get("enabled",   False)
    output:
        metadata  = f"{_wd}/results/ingest/merged_metadata.tsv",
        sequences = f"{_wd}/results/ingest/merged_sequences.fasta"
    shell:
        """
        if [ "{params.source}" = "local" ]; then
            # data_source=local: fetch_local already copied the files; pass them straight through.
            cp {input.ppx_metadata:q}  {output.metadata:q}
            cp {input.ppx_sequences:q} {output.sequences:q}
        else
            flexpipe-merge \
                --pathoplexus-metadata  {input.ppx_metadata:q} \
                --pathoplexus-sequences {input.ppx_sequences:q} \
                --local-metadata        {params.local_metadata:q} \
                --local-sequences       {params.local_sequences:q} \
                --enabled               {params.enabled:q} \
                --metadata-output       {output.metadata:q} \
                --sequences-output      {output.sequences:q}
        fi
        """


# ─── QC + curation ───────────────────────────────────────────────────────────
#
# viralqc.mode controls how the ViralQC results TSV is produced:
#   run         (default) — invoke vqc via BLAST + Nextclade (full QC)
#   precomputed — copy a user-supplied results TSV (viralqc.precomputed path)
#   skip        — synthesize a TSV from sequence IDs; every sequence → quality A
#
# curate_qc is unchanged across all three modes: it always reads the same output file.

if _viralqc_mode == "precomputed":
    rule viralqc:
        """Use a pre-run ViralQC results TSV without invoking vqc."""
        input:
            precomputed = _viralqc_precomputed
        output:
            tsv = f"{_wd}/results/viralqc/outputs/results.tsv"
        shell:
            """
            mkdir -p $(dirname {output.tsv:q})
            cp {input.precomputed:q} {output.tsv:q}
            """

elif _viralqc_mode == "skip":
    rule viralqc:
        """Synthesize a ViralQC results TSV (all grade-A, no vqc) for rapid / local analysis."""
        input:
            sequences = rules.merge_local_sequences.output.sequences
        output:
            tsv = f"{_wd}/results/viralqc/outputs/results.tsv"
        run:
            from flexpipe.ingest.synthesize_viralqc import write_synthetic_viralqc_tsv
            write_synthetic_viralqc_tsv(str(input.sequences), str(output.tsv))

else:
    # "run" (default) — invoke ViralQC (BLAST + Nextclade).
    # genomeQuality (A/B/C/D) + coverage + clade; Pathoplexus clade preserved when vqc
    # does not assign one.
    rule viralqc:
        input:
            sequences = rules.merge_local_sequences.output.sequences
        threads:
            config.get("options", {}).get("threads", 4)
        params:
            datasets_dir = _vqc.get("datasets_dir", ""),
            blast_db     = _vqc.get("blast_database", ""),
            blast_meta   = _vqc.get("blast_database_metadata", ""),
            command      = _viralqc_command(_vqc),
            output_dir   = f"{_wd}/results/viralqc"
        output:
            tsv = f"{_wd}/results/viralqc/outputs/results.tsv"
        shell:
            """
            mkdir -p {params.output_dir:q}
            n=$(grep -c '^>' {input.sequences:q})
            if [ "$n" -eq 0 ]; then
                echo "ERROR: no sequences available for ViralQC in {input.sequences:q}" >&2
                exit 1
            fi
            echo "Running ViralQC on $n sequences..."
            {params.command:q} run \
                --input                   {input.sequences:q} \
                --output-dir              {params.output_dir:q} \
                --output-file             results.tsv \
                --datasets-dir            {params.datasets_dir:q} \
                --blast-database          {params.blast_db:q} \
                --blast-database-metadata {params.blast_meta:q} \
                --cores                   {threads} \
                -v
            """


rule curate_qc:
    input:
        metadata  = rules.merge_local_sequences.output.metadata,
        sequences = rules.merge_local_sequences.output.sequences,
        viralqc   = rules.viralqc.output.tsv
    output:
        renamed    = temp(f"{_wd}/results/ingest/renamed_metadata.tsv"),
        normalized = temp(f"{_wd}/results/ingest/date_normalized_metadata.tsv"),
        dated      = temp(f"{_wd}/results/ingest/dated_metadata.tsv"),
        # curated is NOT temp: the qc_summary rule reads it to count per-grade stats
        # before augur filter drops the low-quality rows.
        curated    = f"{_wd}/results/ingest/curated_metadata.tsv",
        metadata   = f"{_wd}/results/ingest/final_metadata.tsv",
        sequences  = f"{_wd}/results/ingest/final_sequences.fasta",
        filter_log = f"{_wd}/results/ingest/filter_log.tsv"
    params:
        min_coverage    = _qc.get("min_coverage", 0.70),
        quality_filter  = _quality_filter,
        req_col_filter  = _req_col_filter,
        cfg             = _config,
        date_policy_arg = _date_policy_arg,
        date_log        = f"{_wd}/results/ingest/date_normalization.tsv"
    shell:
        """
        augur curate rename \
            --metadata    {input.metadata:q} \
            --id-column   accessionVersion \
            --field-map   accessionVersion=strain \
                          sampleCollectionDate=date \
                          geoLocCountry=country \
                          geoLocAdmin1=division \
                          geoLocAdmin2=location \
                          dataUseTerms=data_use \
                          lineage=clade \
            --output-metadata {output.renamed:q}

        flexpipe-normalize-dates \
            --metadata   {output.renamed:q} \
            --date-field date \
            --output     {output.normalized:q} \
            --log        {params.date_log:q} \
            {params.date_policy_arg:q}

        augur curate format-dates \
            --metadata              {output.normalized:q} \
            --date-fields           date \
            --expected-date-formats '%Y-%m-%d' '%Y-%m' '%Y' '%d-%b-%Y' '%b-%Y' '%m/%d/%Y' \
            --failure-reporting     warn \
            --output-metadata       {output.dated:q}

        flexpipe-curate \
            --config    {params.cfg:q} \
            --metadata  {output.dated:q} \
            --nextclade {input.viralqc:q} \
            --output    {output.curated:q}

        augur filter \
            --metadata        {output.curated:q} \
            --sequences       {input.sequences:q} \
            --query-columns   coverage:float \
            --query           "coverage.isna() or coverage >= {params.min_coverage}" \
            --exclude-where   {params.req_col_filter:q} {params.quality_filter:q} \
            --output-log      {output.filter_log:q} \
            --output-metadata  {output.metadata:q} \
            --output-sequences {output.sequences:q}
        """


# ─── QC summary ──────────────────────────────────────────────────────────────

rule qc_summary:
    """Write per-run QC artifacts: qc_report.json + qc_summary.tsv.

    Reads curated_metadata.tsv (all sequences before augur filter),
    filter_log.tsv (per-strain exclusion reasons from augur filter --output-log),
    and final_metadata.tsv (retained sequences after filter) to produce:
    - <workdir>/results/qc_report.json — structured JSON with grade counts,
      coverage stats, and exclusion-reason breakdown.
    - <workdir>/results/qc_summary.tsv — flat TSV per genome-quality grade.
    """
    input:
        curated    = rules.curate_qc.output.curated,
        filter_log = rules.curate_qc.output.filter_log,
        final      = rules.curate_qc.output.metadata
    output:
        qc_report  = f"{_wd}/results/qc_report.json",
        qc_summary = f"{_wd}/results/qc_summary.tsv"
    shell:
        """
        flexpipe-qc-summary \
            --curated    {input.curated:q} \
            --filter-log {input.filter_log:q} \
            --final      {input.final:q} \
            --qc-report  {output.qc_report:q} \
            --qc-summary {output.qc_summary:q}
        """


# ─── Subsampling ──────────────────────────────────────────────────────────────

rule resolve_subsample_config:
    """Write a workdir-local copy of the subsample config with defaults.max_date injected.

    When flexpipe-run passes --config run_date=<YYYY-MM-DD>, this rule injects that date
    as the upper bound for augur subsample so the analysis window is reproducibly anchored
    to the declared reference date rather than the system clock.

    When run_date is empty (direct snakemake invocation), the source subsample config is
    copied unchanged — preserving current behaviour.
    """
    input:
        subsample_cfg = files.subsample_config
    params:
        run_date = _run_date
    output:
        resolved = f"{_wd}/config/subsample_resolved.yaml"
    run:
        import yaml
        from flexpipe.config import resolve_subsample_config
        with open(input.subsample_cfg, encoding="utf-8") as fh:
            raw = yaml.safe_load(fh) or {}
        resolved = resolve_subsample_config(raw, params.run_date, input.subsample_cfg)
        import os; os.makedirs(os.path.dirname(output.resolved), exist_ok=True)
        with open(output.resolved, "w", encoding="utf-8") as fh:
            yaml.safe_dump(resolved, fh, default_flow_style=False, sort_keys=False)


rule prepare:
    message:
        "Subsampling: focal (ITpS + Brazil) always kept; context by division/year"
    input:
        sequences     = rules.curate_qc.output.sequences,
        metadata      = rules.curate_qc.output.metadata,
        subsample_cfg = rules.resolve_subsample_config.output.resolved
    params:
        seed = _sub.get("random_seed", 42)
    output:
        sequences = _SUBSAMPLED_SEQUENCES,
        metadata  = temp(_SUBSAMPLED_METADATA_RAW)
    shell:
        """
        mkdir -p $(dirname {output.sequences:q})
        augur subsample \
            --sequences        {input.sequences:q} \
            --metadata         {input.metadata:q} \
            --config           {input.subsample_cfg:q} \
            --seed             {params.seed} \
            --output-sequences {output.sequences:q} \
            --output-metadata  {output.metadata:q}
        echo "[subsample] total: $(grep -c '^>' {output.sequences:q}) sequences"
        """


rule disambiguate_geo_metadata:
    message:
        "Disambiguating geographic display names"
    input:
        metadata = rules.prepare.output.metadata
    params:
        columns = _coordinate_columns
    output:
        metadata = _SUBSAMPLED_METADATA
    shell:
        """
        flexpipe-coordinates \
            --metadata          {input.metadata:q} \
            --columns           {params.columns:q} \
            --output            {output.metadata:q} \
            --disambiguate-only
        """


# ─── Colours + coordinates ────────────────────────────────────────────────────

rule generate_name2hue:
    input:
        metadata = rules.disambiguate_geo_metadata.output.metadata
    output:
        name2hue = f"{_wd}/config/name2hue.tsv"
    params:
        cfg = _config,
        cache = _name2hue_cache
    shell:
        """
        mkdir -p $(dirname {output.name2hue:q})
        flexpipe-name2hue \
            --metadata {input.metadata:q} \
            --config   {params.cfg:q} \
            --cache    {params.cache:q} \
            --output   {output.name2hue:q}
        """


rule coordinates:
    message:
        "Geocoding locations from {input.metadata}"
    input:
        metadata = rules.disambiguate_geo_metadata.output.metadata
    params:
        columns       = _coordinate_columns,
        workdir_cache = _workdir_cache,
        force_file_arg = _force_file_arg
    output:
        latlongs = f"{_wd}/config/latlongs.tsv"
    shell:
        """
        mkdir -p $(dirname {output.latlongs:q})
        flexpipe-coordinates \
            --metadata {input.metadata:q} \
            --columns  {params.columns:q} \
            --cache    {params.workdir_cache:q} \
            --output   {output.latlongs:q} \
            {params.force_file_arg:q}

        flexpipe-update-cache \
            --new-latlongs {output.latlongs:q} \
            --cache        {params.workdir_cache:q} \
            --output       {params.workdir_cache:q}
        """


rule colours:
    message:
        "Assigning colour scheme"
    input:
        matrix = rules.disambiguate_geo_metadata.output.metadata,
        scheme = rules.generate_name2hue.output.name2hue
    params:
        host     = _colours.get("host",     "host").split(),
        clade    = _colours.get("clade",    "clade_truncated clade").split(),
        geo      = _colours.get("geo",      "region country").split(),
        source   = _colours.get("source",   "source").split(),
        data_use = _colours.get("data_use", "data_use").split()
    output:
        colours1      = temp(f"{_wd}/config/col_hosts.tsv"),
        colours2      = temp(f"{_wd}/config/col_geo.tsv"),
        colours3      = temp(f"{_wd}/config/col_clade.tsv"),
        colours4      = temp(f"{_wd}/config/col_source.tsv"),
        colours5      = temp(f"{_wd}/config/col_data_use.tsv"),
        colour_scheme = f"{_wd}/config/colour_scheme.tsv"
    shell:
        """
        mkdir -p $(dirname {output.colour_scheme:q})

        flexpipe-colours \
            --input   {input.matrix:q} \
            --colours {input.scheme:q} \
            --levels  {params.host:q} \
            --output  {output.colours1:q}

        flexpipe-colours \
            --input   {input.matrix:q} \
            --colours {input.scheme:q} \
            --levels  {params.geo:q} \
            --output  {output.colours2:q}

        flexpipe-colours \
            --input   {input.matrix:q} \
            --colours {input.scheme:q} \
            --levels  {params.clade:q} \
            --output  {output.colours3:q}

        flexpipe-colours \
            --input   {input.matrix:q} \
            --colours {input.scheme:q} \
            --levels  {params.source:q} \
            --output  {output.colours4:q}

        flexpipe-colours \
            --input   {input.matrix:q} \
            --colours {input.scheme:q} \
            --levels  {params.data_use:q} \
            --output  {output.colours5:q}

        head -1 {output.colours1:q} > {output.colour_scheme:q}
        tail -q -n+2 \
            {output.colours1:q} {output.colours2:q} {output.colours3:q} \
            {output.colours4:q} {output.colours5:q} \
            >> {output.colour_scheme:q}
        """


# ─── Utility ──────────────────────────────────────────────────────────────────

rule clean:
    message: "Remove subsampled outputs — ingest and ViralQC preserved"
    params:
        targets = [
            f"{_wd}/results/subsampled",
            f"{_wd}/config/colour_scheme.tsv",
            f"{_wd}/config/latlongs.tsv",
            f"{_wd}/config/name2hue.tsv",
        ]
    shell:
        "rm -rfv {params.targets:q}"


rule reset:
    message: "Full reset — remove all workdir outputs"
    params:
        targets = [
            f"{_wd}/results",
            f"{_wd}/config/colour_scheme.tsv",
            f"{_wd}/config/latlongs.tsv",
            f"{_wd}/config/name2hue.tsv",
        ]
    shell:
        "rm -rfv {params.targets:q}"
