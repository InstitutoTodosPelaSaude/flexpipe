configfile: "builds/yfv-brazil/config.yaml"

from types import SimpleNamespace

# Config file path passed to flexpipe-* scripts (e.g. flexpipe-curate).
# workflow.configfiles lists every --configfile; flexpipe-run adds a second
# snakemake_resolved.yaml with resolved ViralQC paths for Snakemake params only.
# Scripts need the full build config under builds/<name>/config.yaml.
_config = "builds/yfv-brazil/config.yaml"
if workflow.configfiles:
    for _cf in workflow.configfiles:
        _cf_str = str(_cf).replace("\\", "/")
        if "/builds/" in _cf_str:
            _config = _cf_str
            break
    else:
        for _cf in workflow.configfiles:
            _cf_str = str(_cf)
            if not _cf_str.endswith("snakemake_resolved.yaml"):
                _config = _cf_str
                break

# Per-run output directory. Passed by flexpipe-run as --config workdir=<path>.
# Defaults to "." so a direct snakemake invocation still works from the repo root.
_wd = config.get("workdir", ".")

_local   = config.get("local_sequences", {})
_vqc     = config.get("viralqc", {})
_sub     = config.get("subsampling", {})
_coords  = config.get("coordinates", {})
_colours = config.get("colours", {})
_qc      = config.get("qc", {})

# Derive augur-filter exclusion clauses from qc.genome_quality (pass-list → fail-list)
_pass_grades = set(_qc.get("genome_quality", ["A", "B"]))
_all_grades  = {"A", "B", "C", "D"}
_fail_grades = sorted(_all_grades - _pass_grades)
_quality_filter = " ".join(f'"genome_quality={g}"' for g in _fail_grades) + ' "genome_quality="'

_req_cols        = _qc.get("required_columns", ["strain", "date"])
_req_col_filter  = " ".join(f'"{col}="' for col in _req_cols)

# Optional force-coordinates file
_force_file_arg  = f"--force-file {_coords['force_file']}" if _coords.get("force_file") else ""

# "pathoplexus" (default) or "ncbi" — never both simultaneously
_source = config.get("data_source", "pathoplexus")

# Source-specific raw-fetch outputs
_RAW_METADATA  = f"{_wd}/results/ingest/{_source}_metadata.tsv"
_RAW_SEQUENCES = f"{_wd}/results/ingest/{_source}_sequences.fasta"

# Workdir coordinate cache (writable; seeded from build dir on first run by flexpipe-run)
_workdir_cache = f"{_wd}/cache/cache_coordinates.tsv"

files = SimpleNamespace(**config["files"])


rule all:
    input:
        sequences     = f"{_wd}/results/subsampled/sequences.fasta",
        metadata      = f"{_wd}/results/subsampled/metadata.tsv",
        latlongs      = f"{_wd}/config/latlongs.tsv",
        colour_scheme = f"{_wd}/config/colour_scheme.tsv"


# ─── Fetch + merge ────────────────────────────────────────────────────────────

rule fetch_pathoplexus:
    output:
        metadata  = f"{_wd}/results/ingest/pathoplexus_metadata.tsv",
        sequences = f"{_wd}/results/ingest/pathoplexus_sequences.fasta"
    params:
        cfg = _config
    shell:
        """
        flexpipe-fetch-pathoplexus \
            --config           {params.cfg} \
            --metadata-output  {output.metadata} \
            --sequences-output {output.sequences}
        """


rule fetch_ncbi:
    output:
        metadata  = f"{_wd}/results/ingest/ncbi_metadata.tsv",
        sequences = f"{_wd}/results/ingest/ncbi_sequences.fasta"
    params:
        cfg = _config
    shell:
        """
        flexpipe-fetch-ncbi \
            --config           {params.cfg} \
            --metadata-output  {output.metadata} \
            --sequences-output {output.sequences}
        """


rule merge_local_sequences:
    input:
        ppx_metadata  = _RAW_METADATA,
        ppx_sequences = _RAW_SEQUENCES
    params:
        local_metadata  = _local.get("metadata",  ""),
        local_sequences = _local.get("sequences", ""),
        enabled         = _local.get("enabled",   False)
    output:
        metadata  = f"{_wd}/results/ingest/merged_metadata.tsv",
        sequences = f"{_wd}/results/ingest/merged_sequences.fasta"
    shell:
        """
        flexpipe-merge \
            --pathoplexus-metadata  {input.ppx_metadata} \
            --pathoplexus-sequences {input.ppx_sequences} \
            --local-metadata        {params.local_metadata} \
            --local-sequences       {params.local_sequences} \
            --enabled               {params.enabled} \
            --metadata-output       {output.metadata} \
            --sequences-output      {output.sequences}
        """


# ─── QC + curation ───────────────────────────────────────────────────────────

# ViralQC runs on all sequences (Pathoplexus + local).
# Uses BLAST + Nextclade internally → genomeQuality (A/B/C/D) + coverage + clade.
# Pathoplexus clade is preserved when ViralQC does not assign one.
rule viralqc:
    input:
        sequences = rules.merge_local_sequences.output.sequences
    params:
        datasets_dir = _vqc.get("datasets_dir", ""),
        blast_db     = _vqc.get("blast_database", ""),
        blast_meta   = _vqc.get("blast_database_metadata", ""),
        conda_env    = _vqc.get("conda_env", "viralQC"),
        cores        = config.get("options", {}).get("threads", 4),
        output_dir   = f"{_wd}/results/viralqc"
    output:
        tsv = f"{_wd}/results/viralqc/outputs/results.tsv"
    shell:
        """
        mkdir -p {params.output_dir}
        n=$(grep -c '^>' {input.sequences})
        echo "Running ViralQC on $n sequences..."
        conda run -n {params.conda_env} vqc run \
            --input                   {input.sequences} \
            --output-dir              {params.output_dir} \
            --output-file             results.tsv \
            --datasets-dir            {params.datasets_dir} \
            --blast-database          {params.blast_db} \
            --blast-database-metadata {params.blast_meta} \
            --cores                   {params.cores} \
            -v
        """


rule curate_qc:
    input:
        metadata  = rules.merge_local_sequences.output.metadata,
        sequences = rules.merge_local_sequences.output.sequences,
        viralqc   = rules.viralqc.output.tsv
    output:
        renamed   = temp(f"{_wd}/results/ingest/renamed_metadata.tsv"),
        dated     = temp(f"{_wd}/results/ingest/dated_metadata.tsv"),
        curated   = temp(f"{_wd}/results/ingest/curated_metadata.tsv"),
        metadata  = f"{_wd}/results/ingest/final_metadata.tsv",
        sequences = f"{_wd}/results/ingest/final_sequences.fasta"
    params:
        min_coverage    = _qc.get("min_coverage", 0.70),
        quality_filter  = _quality_filter,
        req_col_filter  = _req_col_filter,
        cfg             = _config
    shell:
        """
        augur curate rename \
            --metadata    {input.metadata} \
            --id-column   accessionVersion \
            --field-map   accessionVersion=strain \
                          sampleCollectionDate=date \
                          geoLocCountry=country \
                          geoLocAdmin1=division \
                          geoLocAdmin2=location \
                          dataUseTerms=data_use \
                          lineage=clade \
            --output-metadata {output.renamed}

        augur curate format-dates \
            --metadata              {output.renamed} \
            --date-fields           date \
            --expected-date-formats '%Y-%m-%d' '%Y-%m' '%Y' '%d-%b-%Y' '%b-%Y' \
            --output-metadata       {output.dated}

        flexpipe-curate \
            --config    {params.cfg} \
            --metadata  {output.dated} \
            --nextclade {input.viralqc} \
            --output    {output.curated}

        augur filter \
            --metadata        {output.curated} \
            --sequences       {input.sequences} \
            --query-columns   coverage:float \
            --query           "coverage.isna() or coverage >= {params.min_coverage}" \
            --exclude-where   {params.req_col_filter} {params.quality_filter} \
            --output-metadata  {output.metadata} \
            --output-sequences {output.sequences}
        """


# ─── Subsampling ──────────────────────────────────────────────────────────────

rule prepare:
    message:
        "Subsampling: focal (ITpS + Brazil) always kept; context by division/year"
    input:
        sequences     = rules.curate_qc.output.sequences,
        metadata      = rules.curate_qc.output.metadata,
        subsample_cfg = files.subsample_config
    params:
        seed = _sub.get("random_seed", 42)
    output:
        sequences = f"{_wd}/results/subsampled/sequences.fasta",
        metadata  = f"{_wd}/results/subsampled/metadata.tsv"
    shell:
        """
        mkdir -p $(dirname {output.sequences})
        augur subsample \
            --sequences        {input.sequences} \
            --metadata         {input.metadata} \
            --config           {input.subsample_cfg} \
            --seed             {params.seed} \
            --output-sequences {output.sequences} \
            --output-metadata  {output.metadata}
        echo "[subsample] total: $(grep -c '^>' {output.sequences}) sequences"
        """


# ─── Colours + coordinates ────────────────────────────────────────────────────

rule generate_name2hue:
    input:
        metadata = rules.prepare.output.metadata
    output:
        name2hue = f"{_wd}/config/name2hue.tsv"
    params:
        cfg = _config
    shell:
        """
        mkdir -p $(dirname {output.name2hue})
        flexpipe-name2hue \
            --metadata {input.metadata} \
            --config   {params.cfg} \
            --output   {output.name2hue}
        """


rule coordinates:
    message:
        "Geocoding locations from {input.metadata}"
    input:
        metadata = rules.prepare.output.metadata
    params:
        columns       = _coords.get("columns", "country division location"),
        workdir_cache = _workdir_cache,
        force_file_arg = _force_file_arg
    output:
        latlongs = f"{_wd}/config/latlongs.tsv"
    shell:
        """
        mkdir -p $(dirname {output.latlongs})
        flexpipe-coordinates \
            --metadata {input.metadata} \
            --columns  {params.columns} \
            --cache    {params.workdir_cache} \
            --output   {output.latlongs} \
            {params.force_file_arg}

        flexpipe-update-cache \
            --new-latlongs {output.latlongs} \
            --cache        {params.workdir_cache} \
            --output       {params.workdir_cache}
        """


rule colours:
    message:
        "Assigning colour scheme"
    input:
        matrix = rules.prepare.output.metadata,
        scheme = rules.generate_name2hue.output.name2hue
    params:
        host     = _colours.get("host",     "host"),
        clade    = _colours.get("clade",    "clade_truncated clade"),
        geo      = _colours.get("geo",      "region country"),
        source   = _colours.get("source",   "source"),
        data_use = _colours.get("data_use", "data_use")
    output:
        colours1      = temp(f"{_wd}/config/col_hosts.tsv"),
        colours2      = temp(f"{_wd}/config/col_geo.tsv"),
        colours3      = temp(f"{_wd}/config/col_clade.tsv"),
        colours4      = temp(f"{_wd}/config/col_source.tsv"),
        colours5      = temp(f"{_wd}/config/col_data_use.tsv"),
        colour_scheme = f"{_wd}/config/colour_scheme.tsv"
    shell:
        """
        mkdir -p $(dirname {output.colour_scheme})

        flexpipe-colours \
            --input   {input.matrix} \
            --colours {input.scheme} \
            --levels  {params.host} \
            --output  {output.colours1}

        flexpipe-colours \
            --input   {input.matrix} \
            --colours {input.scheme} \
            --levels  {params.geo} \
            --output  {output.colours2}

        flexpipe-colours \
            --input   {input.matrix} \
            --colours {input.scheme} \
            --levels  {params.clade} \
            --output  {output.colours3}

        flexpipe-colours \
            --input   {input.matrix} \
            --colours {input.scheme} \
            --levels  {params.source} \
            --output  {output.colours4}

        flexpipe-colours \
            --input   {input.matrix} \
            --colours {input.scheme} \
            --levels  {params.data_use} \
            --output  {output.colours5}

        head -1 {output.colours1} > {output.colour_scheme}
        tail -q -n+2 \
            {output.colours1} {output.colours2} {output.colours3} \
            {output.colours4} {output.colours5} \
            >> {output.colour_scheme}
        """


# ─── Utility ──────────────────────────────────────────────────────────────────

rule clean:
    message: "Remove subsampled outputs — ingest and ViralQC preserved"
    params:
        wd = _wd
    shell:
        "rm -rfv {params.wd}/results/subsampled {params.wd}/config/colour_scheme.tsv {params.wd}/config/latlongs.tsv {params.wd}/config/name2hue.tsv"


rule reset:
    message: "Full reset — remove all workdir outputs"
    params:
        wd = _wd
    shell:
        "rm -rfv {params.wd}/results {params.wd}/config/colour_scheme.tsv {params.wd}/config/latlongs.tsv {params.wd}/config/name2hue.tsv"
